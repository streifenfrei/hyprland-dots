// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/workspaces",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "group/tray-group",
        "cpu",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery"
    ],
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {percentage}%",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}"
    },
    "clock": {
        "format": "<b>{:%H:%M</b> • %a, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#555555'><b>{}</b></span>",
                "weeks": "<span color='#fc9003ee'><b>W{:%U}</b></span>",
                "weekdays": "<span color='#3300b3'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "shift_up",
            "on-click-middle": "shift_reset",
            "on-click-right": "shift_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "group/tray-group": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": false
        },
        "modules": [
            "hyprland/language",
            "tray"
        ]
    },
    "tray": {
        "spacing": 10,
        "show-passive-items": true
    },
    "hyprland/language": {
        "format": "<b>{}</b>",
        "format-de-neo": "neo",
        "format-de": "de"
    },
    "network": {
        "format": "󰈀",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "",
        "format-disconnected": "",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "~/.config/hypr/scripts/start_or_focus.sh nm-connection-editor nm-connection-editor",
        "tooltip": true,
        "tooltip-format": "{ifname}: {ipaddr} \nDown:{bandwidthDownBytes} Up:{bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr} \nDown:{bandwidthDownBytes} Up:{bandwidthUpBytes}",
        "tooltip-format-wifi": "{ifname}: {ipaddr} \nSSID: {essid}\nDown:{bandwidthDownBytes} Up:{bandwidthUpBytes}"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip": true,
        "tooltip-format-connected": "{device_alias} ({device_address})"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": [
            "",
            "",
            ""
        ],
        "format-muted": " - ",
        "tooltip": false
    },
    "battery": {
        "states": {
            "full": 95,
            "9bar": 86,
            "8bar": 78,
            "7bar": 70,
            "6bar": 62,
            "5bar": 54,
            "4bar": 46,
            "3bar": 38,
            "2bar": 30,
            "1bar": 22,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-9bar": "󰂂 {capacity}%",
        "format-8bar": "󰂁 {capacity}%",
        "format-7bar": "󰂀 {capacity}%",
        "format-6bar": "󰁿 {capacity}%",
        "format-5bar": "󰁾 {capacity}%",
        "format-4bar": "󰁽 {capacity}%",
        "format-3bar": "󰁼 {capacity}%",
        "format-2bar": "󰁻 {capacity}%",
        "format-1bar": "󰁺 {capacity}%",
        "format-critical": "󰂃 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "interval": 3,
        "tooltip": true,
        "tooltip-format": "{time}"
    }
}