// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/window"
    ],
    "modules-center": [
        "group/resources",
        "hyprland/workspaces",
        "clock"
    ],
    "modules-right": [
        "custom/recording",
        "group/tray-group",
        "pulseaudio",
        "network",
        "bluetooth",
        "battery"
    ],
    "group/resources": {
        "orientation":"inherit",
        "modules": [
            "cpu",
            "memory"
        ]
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {percentage}%   {swapPercentage}%",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "",
        "persistent-workspaces": {
            "*": 5
        }
    },
    "clock": {
        "format": "<b>{:%H:%M</b> • %a, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#555555'><b>{}</b></span>",
                "weeks": "<span color='#fc9003ee'><b>W{:%U}</b></span>",
                "weekdays": "<span color='#3300b3'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "shift_up",
            "on-click-middle": "shift_reset",
            "on-click-right": "shift_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/recording": {
        "exec": "~/.config/hypr/scripts/is_recording.sh",
        "interval": "once",
        "signal": 1,
        "on-click": "pkill wf-recorder && pkill --signal 35 waybar"
    },
    "group/tray-group": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": false
        },
        "modules": [
            "hyprland/language",
            "tray"
        ]
    },
    "tray": {
        "spacing": 10,
        "show-passive-items": true
    },
    "hyprland/language": {
        "format": "{}",
        "format-de-neo": "neo",
        "format-de": "de"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            ""
        ],
        "format-muted": "",
        "tooltip": false
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "",
        "format-disconnected": "",
        "format": "",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "~/.config/hypr/scripts/start_or_focus.sh nm-connection-editor nm-connection-editor",
        "tooltip": false
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "battery": {
        "states": {
            "full": 95,
            "9bar": 86,
            "8bar": 78,
            "7bar": 70,
            "6bar": 62,
            "5bar": 54,
            "4bar": 46,
            "3bar": 38,
            "2bar": 30,
            "1bar": 22,
            "critical": 15
        },
        "format": "󰁹",
        "format-full": "󰁹",
        "format-9bar": "󰂂",
        "format-8bar": "󰂁",
        "format-7bar": "󰂀",
        "format-6bar": "󰁿",
        "format-5bar": "󰁾",
        "format-4bar": "󰁽",
        "format-3bar": "󰁼",
        "format-2bar": "󰁻",
        "format-1bar": "󰁺",
        "format-critical": "󰂃",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "tooltip": false,
        "interval": 3
    }
}